# MolarMetrics settings. Copy to .env to customise:  cp .env.example .env
# Every value below is also the built-in default, so .env is optional.

# Local Ollama model and server
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Per-request timeout (seconds) and context window (tokens) for the model
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192

# Where the synthetic data lives (defaults to ./data)
# MOLARMETRICS_DATA_DIR=data
# MOLARMETRICS_DB_PATH=data/molarmetrics.db

# Note: LangChain/LangSmith remote tracing is always forced OFF by
# molarmetrics/config.py, even if a tracing variable is set here.
