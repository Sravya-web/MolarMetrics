# MolarMetrics settings. Copy to .env to customise:  cp .env.example .env
# Every value below is also the built-in default, so .env is optional.

# --- Local question service (Ollama) -----------------------------------------
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
# Per-request timeout (seconds) and context window (tokens) for the model
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192

# --- Web app -------------------------------------------------------------------
# Port of the API (and of the built app served by scripts/start.sh).
# The server always binds to 127.0.0.1 (this computer only).
MOLARMETRICS_API_PORT=8000
# Where uploaded datasets, unfinished uploads and the session registry live.
# Keep it on this computer; it is git-ignored.
# MOLARMETRICS_RUNTIME_DIR=runtime
# Uploaded data is deleted after this many hours without use.
MOLARMETRICS_RETENTION_HOURS=24
# How often (minutes) the running server checks for expired data.
MOLARMETRICS_CLEANUP_INTERVAL_MINUTES=10
# Upload limits.
MOLARMETRICS_MAX_UPLOAD_MB=20
MOLARMETRICS_MAX_UPLOAD_FILES=10
# Host names the API answers to (protection against DNS rebinding).
MOLARMETRICS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Bundled sample data ---------------------------------------------------------
# MOLARMETRICS_DATA_DIR=data
# MOLARMETRICS_DB_PATH=data/molarmetrics.db

# Note: LangChain/LangSmith remote tracing is always forced OFF by
# molarmetrics/config.py, even if a tracing variable is set here.
